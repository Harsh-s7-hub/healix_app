<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical"
    tools:context=".home_page">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/linearLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/home_action_bar_design"
                android:orientation="vertical"
                android:paddingBottom="12dp">

                <ImageView
                    android:layout_width="@dimen/logo_width"
                    android:layout_height="@dimen/logo_height"
                    android:layout_gravity="center"
                    android:adjustViewBounds="true"
                    android:src="@drawable/logo" />

                <EditText
                    android:id="@+id/searchBar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/search_bar_height"
                    android:layout_marginStart="@dimen/screen_margin_horizontal_large"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="@dimen/screen_margin_horizontal_large"
                    android:background="@drawable/search_bar_design"
                    android:drawableStart="@drawable/search_icon"
                    android:fontFamily="@font/poppins_medium"
                    android:gravity="center_vertical"
                    android:imeOptions="actionDone"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingStart="12dp"
                    android:paddingTop="13dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="10dp"
                    android:textColor="@color/black"
                    android:textColorHint="#424142"
                    android:textSize="17sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin_horizontal"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="@dimen/screen_margin_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/greetingText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/poppins_semibold"
                        android:text="It's Time for Lunch!"
                        android:textColor="@color/text_heading"
                        android:textSize="25sp"
                        tools:ignore="HardcodedText" />

                    <ImageView
                        android:id="@+id/greetingImg"
                        android:layout_width="30dp"
                        android:layout_height="30dp"
                        android:layout_marginStart="10dp"
                        android:src="@drawable/food_img" />
                </LinearLayout>

                <TextView
                    android:id="@+id/greetingDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:fontFamily="@font/poppins_light"
                    android:text="Your breakfast was a bit light today! Let's boost your energy with a delicious lunch."
                    android:textColor="@color/text_heading"
                    android:textSize="18sp"
                    tools:ignore="HardcodedText" />
            </LinearLayout>

            <include
                android:id="@+id/aiChatbotBannerInclude"
                layout="@layout/layout_ai_chatbot_banner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/ai_banner_height"
                android:layout_marginStart="@dimen/screen_margin_horizontal"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="@dimen/screen_margin_horizontal" />

<!--          USER DATA-->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/screen_margin_horizontal"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="@dimen/screen_margin_horizontal"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/stepCountButton"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/health_card_height"
                        android:layout_marginEnd="@dimen/health_card_spacing"
                        android:layout_weight="1"
                        app:cardCornerRadius="20dp"
                        app:strokeColor="@android:color/transparent">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_card_steps" />

                            <!-- Glassmorphic floating circle in the top-left corner (Super-Sized) -->
                            <View
                                android:layout_width="85dp"
                                android:layout_height="85dp"
                                android:layout_gravity="start|top"
                                android:layout_marginStart="-28dp"
                                android:layout_marginTop="-28dp"
                                android:alpha="0.25"
                                android:background="@drawable/shape_ai_float_circle" />

                            <!-- Glassmorphic floating circle in the bottom-right corner (Super-Sized) -->
                            <View
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:layout_gravity="end|bottom"
                                android:layout_marginEnd="-32dp"
                                android:layout_marginBottom="-32dp"
                                android:alpha="0.3"
                                android:background="@drawable/shape_ai_float_circle" />

                            <!-- Premium Vertical Centered Content -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="55dp"
                                    android:layout_height="55dp"
                                    android:src="@drawable/steps_icon" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:text="Steps"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    tools:ignore="HardcodedText" />
                            </LinearLayout>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/sleep_cycle"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/health_card_height"
                        android:layout_weight="1"
                        app:cardCornerRadius="20dp"
                        app:strokeColor="@android:color/transparent">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_card_sleep" />

                            <!-- Glassmorphic floating circle in the top-left corner (Super-Sized) -->
                            <View
                                android:layout_width="85dp"
                                android:layout_height="85dp"
                                android:layout_gravity="start|top"
                                android:layout_marginStart="-28dp"
                                android:layout_marginTop="-28dp"
                                android:alpha="0.25"
                                android:background="@drawable/shape_ai_float_circle" />

                            <!-- Glassmorphic floating circle in the bottom-right corner (Super-Sized) -->
                            <View
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:layout_gravity="end|bottom"
                                android:layout_marginEnd="-32dp"
                                android:layout_marginBottom="-32dp"
                                android:alpha="0.3"
                                android:background="@drawable/shape_ai_float_circle" />

                            <!-- Premium Vertical Centered Content -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="60dp"
                                    android:layout_height="60dp"
                                    android:src="@drawable/sleep_icon" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="3dp"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:text="Sleep"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    tools:ignore="HardcodedText" />
                            </LinearLayout>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/health_card_spacing"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/heart_bpm"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/health_card_height"
                        android:layout_marginEnd="@dimen/health_card_spacing"
                        android:layout_weight="1"
                        app:cardCornerRadius="20dp"
                        app:strokeColor="@android:color/transparent">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_card_heart" />

                            <!-- Glassmorphic floating circle in the top-left corner (Super-Sized) -->
                            <View
                                android:layout_width="85dp"
                                android:layout_height="85dp"
                                android:layout_gravity="start|top"
                                android:layout_marginStart="-28dp"
                                android:layout_marginTop="-28dp"
                                android:alpha="0.25"
                                android:background="@drawable/shape_ai_float_circle" />

                            <!-- Glassmorphic floating circle in the bottom-right corner (Super-Sized) -->
                            <View
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:layout_gravity="end|bottom"
                                android:layout_marginEnd="-32dp"
                                android:layout_marginBottom="-32dp"
                                android:alpha="0.3"
                                android:background="@drawable/shape_ai_float_circle" />

                            <!-- Premium Vertical Centered Content -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="55dp"
                                    android:layout_height="55dp"
                                    android:src="@drawable/heart_icon" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:text="Heart Rate"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    tools:ignore="HardcodedText" />
                            </LinearLayout>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/calorie_burn"
                        android:layout_width="0dp"
                        android:layout_height="@dimen/health_card_height"
                        android:layout_weight="1"
                        app:cardCornerRadius="20dp"
                        app:strokeColor="@android:color/transparent">

                        <FrameLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_card_calorie" />

                            <!-- Glassmorphic floating circle in the top-left corner (Super-Sized) -->
                            <View
                                android:layout_width="85dp"
                                android:layout_height="85dp"
                                android:layout_gravity="start|top"
                                android:layout_marginStart="-28dp"
                                android:layout_marginTop="-28dp"
                                android:alpha="0.25"
                                android:background="@drawable/shape_ai_float_circle" />

                            <!-- Glassmorphic floating circle in the bottom-right corner (Super-Sized) -->
                            <View
                                android:layout_width="100dp"
                                android:layout_height="100dp"
                                android:layout_gravity="end|bottom"
                                android:layout_marginEnd="-32dp"
                                android:layout_marginBottom="-32dp"
                                android:alpha="0.3"
                                android:background="@drawable/shape_ai_float_circle" />

                            <!-- Premium Vertical Centered Content -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:gravity="center"
                                android:orientation="vertical">

                                <ImageView
                                    android:layout_width="55dp"
                                    android:layout_height="55dp"
                                    android:src="@drawable/calories_img" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:fontFamily="@font/poppins_semibold"
                                    android:text="Calories"
                                    android:textColor="@color/white"
                                    android:textSize="14sp"
                                    tools:ignore="HardcodedText" />
                            </LinearLayout>
                        </FrameLayout>
                    </com.google.android.material.card.MaterialCardView>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="15dp"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_margin_horizontal"
                android:paddingEnd="@dimen/screen_margin_horizontal">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_extrabold"
                    android:text="Free expert answers to your health questions"
                    android:textColor="@color/text_heading"
                    android:textSize="20sp"
                    tools:ignore="HardcodedText" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/carousel_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="never"
                    android:paddingStart="@dimen/screen_margin_horizontal"
                    android:paddingEnd="@dimen/screen_margin_horizontal" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/askyourquestion"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/button_height"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?attr/selectableItemBackground"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:strokeColor="@android:color/transparent">

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent">

                        <!-- Modern Blue-Purple Premium Gradient -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_button_gradient" />

                        <!-- Glassmorphic floating circle in start -->
                        <View
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_gravity="start|center_vertical"
                            android:layout_marginStart="-8dp"
                            android:alpha="0.25"
                            android:background="@drawable/shape_ai_float_circle" />

                        <!-- Glassmorphic floating square in end -->
                        <View
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="end|center_vertical"
                            android:layout_marginEnd="-6dp"
                            android:alpha="0.2"
                            android:background="@drawable/shape_ai_float_square"
                            android:rotation="45" />

                        <!-- Button Text -->
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:fontFamily="@font/poppins_semibold"
                            android:text="Ask A Free Question"
                            android:textColor="@color/white"
                            android:textSize="16sp" />
                    </FrameLayout>
                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="@font/poppins_medium"
                    android:text="@string/underlined_text"
                    android:textColor="@color/text_heading"
                    android:textSize="17sp" />
            </LinearLayout>

            <Space
                android:layout_width="match_parent"
                android:layout_height="@dimen/section_spacing" />
        </LinearLayout>
    </ScrollView>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardView2"
        android:layout_width="match_parent"
        android:layout_height="@dimen/bottom_nav_height"
        android:layout_marginStart="@dimen/screen_margin_horizontal_large"
        android:layout_marginEnd="@dimen/screen_margin_horizontal_large"
        android:layout_marginBottom="@dimen/bottom_nav_margin_bottom"
        android:background="@drawable/rounded_nav_background"
        app:cardBackgroundColor="@color/surface_page"
        app:cardCornerRadius="100dp"
        app:cardElevation="5dp">

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavigationView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            app:itemActiveIndicatorStyle="@style/BottomNavIndicator"
            app:itemIconTint="@color/nav_icon_color"
            app:itemRippleColor="@color/nav_ripple"
            app:labelVisibilityMode="unlabeled"
            app:menu="@menu/bottom_nav_menu" />
    </androidx.cardview.widget.CardView>

</LinearLayout>
